{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransitJSON Shape",
  "description": "Güzergâh geometrisi. Doğrudan lat/lon koordinat dizisi kullanılır; encoded polyline yoktur. route_patterns.shape_id ile seçilir.",
  "type": "object",
  "properties": {
    "shape_id": {
      "type": "string"
    },
    "route_id": {
      "type": ["string", "null"],
      "description": "Bu şeklin ait olduğu hat. Opsiyonel/null."
    },
    "coordinates": {
      "type": "array",
      "description": "Güzergâh noktaları (sıralı).",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "additionalProperties": false
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "shape_id",
    "coordinates",
    "updated_at"
  ],
  "additionalProperties": false
}
