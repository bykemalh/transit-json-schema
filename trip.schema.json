{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransitJSON Trip",
  "description": "Bir hatta ve güzergâh varyantına ait somut sefer. route_id ve direction alanları geriye uyumluluk ve hızlı filtreleme için pattern kaydıyla birlikte taşınır.",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "pattern_id": {
      "type": "string",
      "minLength": 1,
      "description": "route_patterns.json içindeki güzergâh varyantına referans."
    },
    "direction": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ],
      "description": "0: tek/atanmamış yön, 1: gidiş, 2: dönüş. Ring bilgisi route pattern üzerindeki is_loop alanındadır."
    },
    "service_type": {
      "type": "string",
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "description": "Seferin geçerli olduğu haftanın günü."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "route_id",
    "pattern_id",
    "direction",
    "service_type",
    "updated_at"
  ],
  "additionalProperties": false
}
